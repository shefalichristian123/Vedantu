@model RegisterViewModel
@{
    ViewData["Title"] = "Student Registration";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-head">
            <span class="pill">STUDENT ACCOUNT</span>
            <h1>Create your account</h1>
            <p>Join Vedantu and start learning online.</p>
        </div>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <label asp-for="FullName"></label>
            <input asp-for="FullName" placeholder="Enter your full name" autocomplete="name" />
            <span asp-validation-for="FullName" class="validation"></span>

            <label asp-for="Email"></label>
            <input asp-for="Email" placeholder="you@example.com" autocomplete="email" />
            <span asp-validation-for="Email" class="validation"></span>

            <label asp-for="Phone"></label>
            <input asp-for="Phone" placeholder="Enter mobile number" autocomplete="tel" />
            <span asp-validation-for="Phone" class="validation"></span>

            <label asp-for="Password"></label>
            <input asp-for="Password" placeholder="Minimum 6 characters" autocomplete="new-password" />
            <span asp-validation-for="Password" class="validation"></span>

            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" placeholder="Re-enter password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="validation"></span>

            <button class="btn primary full" type="submit">Create Account</button>
        </form>

        <p class="switch">Already registered? <a asp-action="Login">Login here</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
