@{
    ViewData["Title"] = "Student Dashboard";
}

<section class="dashboard">
    <div class="dash-top">
        <div>
            <span class="pill">STUDENT DASHBOARD</span>
            <h1>Welcome, @User.Identity?.Name 👋</h1>
            <p>Your learning workspace is ready.</p>
        </div>
    </div>

    <div class="dash-grid">
        <article><div class="icon">📚</div><h3>My Courses</h3><p>Your enrolled courses will appear here.</p></article>
        <article><div class="icon">📝</div><h3>Online Exams</h3><p>Take tests and track your results.</p></article>
        <article><div class="icon">🛒</div><h3>Books</h3><p>Browse and purchase study resources.</p></article>
        <article><div class="icon">💳</div><h3>Payments</h3><p>Your future orders and payment history.</p></article>
    </div>
</section>
