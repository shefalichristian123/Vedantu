<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Vedantu</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="nav">
    <a class="brand" asp-controller="Home" asp-action="Index">Vedantu</a>
    <nav>
        <a asp-controller="Home" asp-action="Index">Home</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Account" asp-action="Dashboard">Dashboard</a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button class="nav-button" type="submit">Logout</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Login</a>
            <a class="nav-cta" asp-controller="Account" asp-action="Register">Register</a>
        }
    </nav>
</header>

<main>
    @RenderBody()
</main>

<footer>
    <p>© @DateTime.Now.Year Vedantu Learning Platform</p>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
