@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-content">
        <span class="pill">ONLINE LEARNING PLATFORM</span>
        <h1>Learn smarter.<br><span>Grow faster.</span></h1>
        <p>Build your skills with courses, online tests and learning resources in one place.</p>
        <div class="actions">
            <a class="btn primary" asp-controller="Account" asp-action="Register">Get Started</a>
            <a class="btn secondary" asp-controller="Account" asp-action="Login">Student Login</a>
        </div>
    </div>
    <div class="hero-card">
        <div class="circle">V</div>
        <h3>Start your learning journey</h3>
        <p>Register today and access your student dashboard.</p>
    </div>
</section>

<section class="features">
    <div><b>📚 Courses</b><span>Structured learning content</span></div>
    <div><b>📝 Online Exams</b><span>Practice and test your knowledge</span></div>
    <div><b>🛒 Books</b><span>Learning resources and study material</span></div>
</section>
